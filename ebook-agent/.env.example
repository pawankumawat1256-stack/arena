# Copy this file to .env and fill in your keys. Never commit .env.

# --- Application ---------------------------------------------------------------
APP_ENV=production
LOG_LEVEL=INFO
# Signs unsubscribe links. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=
# Sent as the X-API-Key header on protected endpoints. Generate the same way.
API_KEY=
# Public HTTPS address of the API. Used in download links, unsubscribe links, and webhook URLs.
PUBLIC_BASE_URL=https://api.example.com
DATA_DIR=./data
# SQLite by default. For PostgreSQL: postgresql+psycopg://USER:PASSWORD@HOST:5432/ebook_agent
DATABASE_URL=sqlite:///./data/ebook_agent.db
# Leave empty only on a private network.
DASHBOARD_PASSWORD=
DASHBOARD_API_URL=http://localhost:8000

# --- OpenAI --------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.4

# --- Notion --------------------------------------------------------------------
NOTION_API_KEY=
# ID of the Notion page that receives manuscripts. Share that page with your integration.
NOTION_PARENT_PAGE_ID=

# --- Google: Gmail and Drive (one OAuth client and token) ----------------------
GOOGLE_CLIENT_SECRETS_FILE=./secrets/google_client_secret.json
GOOGLE_TOKEN_FILE=./secrets/google_token.json
GOOGLE_DRIVE_FOLDER_ID=
# Required before any marketing email is sent (CAN-SPAM). Your physical postal address.
BUSINESS_POSTAL_ADDRESS=

# --- Gumroad -------------------------------------------------------------------
# OAuth access token from your Gumroad application. It needs the view_sales scope.
GUMROAD_ACCESS_TOKEN=
# Random string. Your Ping / webhook URL becomes https://YOUR_HOST/webhook/gumroad?token=THIS_VALUE
GUMROAD_WEBHOOK_TOKEN=

# --- Instagram Graph API (Facebook Login) --------------------------------------
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_GRAPH_BASE_URL=https://graph.facebook.com
GRAPH_API_VERSION=v21.0
INSTAGRAM_DAILY_POST_LIMIT=100

# --- Stripe (optional) ---------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Business rules ------------------------------------------------------------
KDP_LIST_PRICE_USD=9.99
KDP_FILE_SIZE_MB=3.0
TOOLKIT_PRICE_USD=19.00
BUNDLE_PRICE_USD=24.00
AMAZON_IN_WITHHOLDING_RATE=0.10
BUYER_LINK_TTL_HOURS=72
BUYER_MAX_DOWNLOADS=5
MARKETING_POSTS_PER_WEEK=3
EMAIL_BATCH_LIMIT=50

# --- Scheduler -----------------------------------------------------------------
SCHEDULER_TIMEZONE=Asia/Kolkata
ANALYTICS_CRON_HOUR=7
MARKETING_CRON_WEEKDAY=mon
MARKETING_CRON_HOUR=9
